# =============================================================================
# Environment template — copy to .env and fill in locally
# =============================================================================
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit a real key, paste one into a YAML config,
# pass one on a command line (it lands in shell history), or put one in a log.
#
# The cloud scripts read the key from the environment variable named by
# `cloud.api_key_env` in the run config (default: OPENAI_API_KEY) and fail with
# a clear missing-key error if it is absent. They never print it, and every log
# line and exception message passes through credential redaction.
#
# Offline tests require no key at all: they inject a fake HTTP transport.
# =============================================================================

# --- OpenAI (cloud attacker / target / evaluator) --------------------------- #
# Required only for provider: openai roles.
OPENAI_API_KEY=

# Optional: alternate OpenAI-compatible endpoint (leave blank for the default).
OPENAI_BASE_URL=

# --- Anthropic (optional, not used by the cloud paper configuration) -------- #
ANTHROPIC_API_KEY=

# --- Local model serving (optional) ---------------------------------------- #
OLLAMA_BASE_URL=http://localhost:11434

# --- Windows / conda: duplicate OpenMP runtime workaround ------------------ #
# Some conda environments ship two OpenMP runtimes, which aborts Python at
# import time ("OMP: Error #15"). Uncomment only if you hit that error.
# KMP_DUPLICATE_LIB_OK=TRUE
